# development | test | staging | production
ENVIRONMENT=development

OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
TAVILY_API_KEY=

DATABASE_URL=postgresql+asyncpg://enercol:enercol@localhost:5432/enercol

SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=false
# Use "none" (with secure cookies) only when the frontend and API live on different sites.
SESSION_COOKIE_SAMESITE=lax

# memory:// is per process; use redis://host:6379 when running more than one replica.
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_AUTH=10/minute;50/hour
RATE_LIMIT_AGENT=15/minute;300/day
RATE_LIMIT_UPLOAD=20/hour

LOG_LEVEL=INFO
# Defaults to console in development/test and json elsewhere.
LOG_FORMAT=

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
